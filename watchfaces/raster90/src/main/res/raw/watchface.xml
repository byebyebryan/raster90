<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- Raster 90 post-V1 single-grid composition: resource-only WFF v2. -->
<WatchFace width="466" height="466">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:00"/>

  <!-- The editor exposes a deliberate Celsius default with an explicit
       Fahrenheit override.  The selected value is also used below to
       normalize the provider's preferred-unit weather integer. -->
  <UserConfigurations>
    <ListConfiguration id="temperatureUnit"
        displayName="temperature_unit_label"
        screenReaderText="temperature_unit_label"
        defaultValue="CELSIUS">
      <ListOption id="CELSIUS"
          displayName="temperature_unit_celsius"
          screenReaderText="temperature_unit_celsius" />
      <ListOption id="FAHRENHEIT"
          displayName="temperature_unit_fahrenheit"
          screenReaderText="temperature_unit_fahrenheit" />
    </ListConfiguration>
  </UserConfigurations>

  <BitmapFonts>
    <!-- 5x7 compact glyphs on the one solid 3x3 source grid.  Ordinary glyphs use
         six-cell (18-unit) advances; the literal space is two cells (6). -->
    <BitmapFont name="raster_fine">
      <Character name=" " resource="raster_fine_space" width="6" height="21"/>
      <Character name="-" resource="raster_fine_minus" width="18" height="21"/>
      <Character name="%" resource="raster_fine_percent" width="18" height="21"/>
      <Character name="°" resource="raster_fine_degree" width="18" height="21"/>
      <Character name="0" resource="raster_fine_0" width="18" height="21"/>
      <Character name="1" resource="raster_fine_1" width="18" height="21"/>
      <Character name="2" resource="raster_fine_2" width="18" height="21"/>
      <Character name="3" resource="raster_fine_3" width="18" height="21"/>
      <Character name="4" resource="raster_fine_4" width="18" height="21"/>
      <Character name="5" resource="raster_fine_5" width="18" height="21"/>
      <Character name="6" resource="raster_fine_6" width="18" height="21"/>
      <Character name="7" resource="raster_fine_7" width="18" height="21"/>
      <Character name="8" resource="raster_fine_8" width="18" height="21"/>
      <Character name="9" resource="raster_fine_9" width="18" height="21"/>
      <Character name="A" resource="raster_fine_a" width="18" height="21"/>
      <Character name="B" resource="raster_fine_b" width="18" height="21"/>
      <Character name="C" resource="raster_fine_c" width="18" height="21"/>
      <Character name="D" resource="raster_fine_d" width="18" height="21"/>
      <Character name="E" resource="raster_fine_e" width="18" height="21"/>
      <Character name="F" resource="raster_fine_f" width="18" height="21"/>
      <Character name="G" resource="raster_fine_g" width="18" height="21"/>
      <Character name="H" resource="raster_fine_h" width="18" height="21"/>
      <Character name="I" resource="raster_fine_i" width="18" height="21"/>
      <Character name="J" resource="raster_fine_j" width="18" height="21"/>
      <Character name="K" resource="raster_fine_k" width="18" height="21"/>
      <Character name="L" resource="raster_fine_l" width="18" height="21"/>
      <Character name="M" resource="raster_fine_m" width="18" height="21"/>
      <Character name="N" resource="raster_fine_n" width="18" height="21"/>
      <Character name="O" resource="raster_fine_o" width="18" height="21"/>
      <Character name="P" resource="raster_fine_p" width="18" height="21"/>
      <Character name="Q" resource="raster_fine_q" width="18" height="21"/>
      <Character name="R" resource="raster_fine_r" width="18" height="21"/>
      <Character name="S" resource="raster_fine_s" width="18" height="21"/>
      <Character name="T" resource="raster_fine_t" width="18" height="21"/>
      <Character name="U" resource="raster_fine_u" width="18" height="21"/>
      <Character name="V" resource="raster_fine_v" width="18" height="21"/>
      <Character name="W" resource="raster_fine_w" width="18" height="21"/>
      <Character name="X" resource="raster_fine_x" width="18" height="21"/>
      <Character name="Y" resource="raster_fine_y" width="18" height="21"/>
      <Character name="Z" resource="raster_fine_z" width="18" height="21"/>
    </BitmapFont>

    <!-- Selected primary/display cut: reviewed clean-chamfer variant,
         four 26-cell digit boxes and a 10-cell colon make 342 units. The
         square and legacy fine-chamfer controls remain source-only. -->
    <BitmapFont name="raster_time">
      <Character name="0" resource="raster_time_0" width="78" height="96"/>
      <Character name="1" resource="raster_time_1" width="78" height="96"/>
      <Character name="2" resource="raster_time_2" width="78" height="96"/>
      <Character name="3" resource="raster_time_3" width="78" height="96"/>
      <Character name="4" resource="raster_time_4" width="78" height="96"/>
      <Character name="5" resource="raster_time_5" width="78" height="96"/>
      <Character name="6" resource="raster_time_6" width="78" height="96"/>
      <Character name="7" resource="raster_time_7" width="78" height="96"/>
      <Character name="8" resource="raster_time_8" width="78" height="96"/>
      <Character name="9" resource="raster_time_9" width="78" height="96"/>
      <Character name=":" resource="raster_time_colon" width="30" height="96"/>
    </BitmapFont>

    <!-- Weather CONDITION is mapped to one direct-authored 16x16 tile per
         day/night family.  The two families retain the existing WFF v2
         condition semantics and four-entry flat weather palette. -->
    <BitmapFont name="raster_weather_day">
      <Character name="0" resource="raster_weather_day_00" width="48" height="48"/>
      <Character name="1" resource="raster_weather_day_01" width="48" height="48"/>
      <Character name="2" resource="raster_weather_day_02" width="48" height="48"/>
      <Character name="3" resource="raster_weather_day_03" width="48" height="48"/>
      <Character name="4" resource="raster_weather_day_04" width="48" height="48"/>
      <Character name="5" resource="raster_weather_day_05" width="48" height="48"/>
      <Character name="6" resource="raster_weather_day_06" width="48" height="48"/>
      <Character name="7" resource="raster_weather_day_07" width="48" height="48"/>
      <Character name="8" resource="raster_weather_day_08" width="48" height="48"/>
      <Character name="9" resource="raster_weather_day_09" width="48" height="48"/>
      <Word name="10" resource="raster_weather_day_10" width="48" height="48"/>
      <Word name="11" resource="raster_weather_day_11" width="48" height="48"/>
      <Word name="12" resource="raster_weather_day_12" width="48" height="48"/>
      <Word name="13" resource="raster_weather_day_13" width="48" height="48"/>
      <Word name="14" resource="raster_weather_day_14" width="48" height="48"/>
      <Word name="15" resource="raster_weather_day_15" width="48" height="48"/>
    </BitmapFont>
    <BitmapFont name="raster_weather_night">
      <Character name="0" resource="raster_weather_night_00" width="48" height="48"/>
      <Character name="1" resource="raster_weather_night_01" width="48" height="48"/>
      <Character name="2" resource="raster_weather_night_02" width="48" height="48"/>
      <Character name="3" resource="raster_weather_night_03" width="48" height="48"/>
      <Character name="4" resource="raster_weather_night_04" width="48" height="48"/>
      <Character name="5" resource="raster_weather_night_05" width="48" height="48"/>
      <Character name="6" resource="raster_weather_night_06" width="48" height="48"/>
      <Character name="7" resource="raster_weather_night_07" width="48" height="48"/>
      <Character name="8" resource="raster_weather_night_08" width="48" height="48"/>
      <Character name="9" resource="raster_weather_night_09" width="48" height="48"/>
      <Word name="10" resource="raster_weather_night_10" width="48" height="48"/>
      <Word name="11" resource="raster_weather_night_11" width="48" height="48"/>
      <Word name="12" resource="raster_weather_night_12" width="48" height="48"/>
      <Word name="13" resource="raster_weather_night_13" width="48" height="48"/>
      <Word name="14" resource="raster_weather_night_14" width="48" height="48"/>
      <Word name="15" resource="raster_weather_night_15" width="48" height="48"/>
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff000000">
    <Group x="8" y="8" width="450" height="450" name="active_frame">
      <!-- Ambient intentionally leaves only the live time outside this group. -->
      <Group x="0" y="0" width="450" height="450" name="interactive_information">
        <Variant mode="AMBIENT" target="alpha" value="0"/>

        <!-- 45..93 active-frame band: true16 weather tile and one centered value. -->
        <Group x="162" y="45" width="162" height="48" name="weather_region">
          <Condition>
            <Expressions>
              <Expression name="weather_available">[WEATHER.IS_AVAILABLE]</Expression>
            </Expressions>
            <Compare expression="weather_available">
              <Group x="0" y="0" width="162" height="48" name="weather_available_view">
                <Condition>
                  <Expressions>
                    <Expression name="weather_is_day">[WEATHER.IS_DAY]</Expression>
                  </Expressions>
                  <Compare expression="weather_is_day">
                    <PartText x="0" y="0" width="48" height="48" name="weather_icon_day">
                      <Text align="CENTER">
                        <BitmapFont family="raster_weather_day" size="48">
                          <Template><![CDATA[%s]]>
                            <Parameter expression="([WEATHER.CONDITION] &gt;= 0 &amp;&amp; [WEATHER.CONDITION] &lt;= 15) ? [WEATHER.CONDITION] : 0"/>
                          </Template>
                        </BitmapFont>
                      </Text>
                    </PartText>
                  </Compare>
                  <Default>
                    <PartText x="0" y="0" width="48" height="48" name="weather_icon_night">
                      <Text align="CENTER">
                        <BitmapFont family="raster_weather_night" size="48">
                          <Template><![CDATA[%s]]>
                            <Parameter expression="([WEATHER.CONDITION] &gt;= 0 &amp;&amp; [WEATHER.CONDITION] &lt;= 15) ? [WEATHER.CONDITION] : 0"/>
                          </Template>
                        </BitmapFont>
                      </Text>
                    </PartText>
                  </Default>
                </Condition>
                <PartText x="54" y="13" width="108" height="21" name="weather_temperature">
                  <Text align="START">
                    <BitmapFont family="raster_fine" size="21" color="#ffffffff">
                      <Template><![CDATA[%d°%s]]>
                        <Parameter expression="[CONFIGURATION.temperatureUnit] == &quot;CELSIUS&quot; ? ([WEATHER.TEMPERATURE_UNIT] == 1 ? [WEATHER.TEMPERATURE] : round(([WEATHER.TEMPERATURE] - 32) * 5 / 9)) : ([WEATHER.TEMPERATURE_UNIT] == 2 ? [WEATHER.TEMPERATURE] : round([WEATHER.TEMPERATURE] * 9 / 5 + 32))"/>
                        <Parameter expression="[CONFIGURATION.temperatureUnit] == &quot;CELSIUS&quot; ? &quot;C&quot; : &quot;F&quot;"/>
                      </Template>
                    </BitmapFont>
                  </Text>
                </PartText>
                <Condition>
                  <Expressions>
                    <Expression name="weather_error">[WEATHER.IS_ERROR]</Expression>
                  </Expressions>
                  <Compare expression="weather_error">
                    <PartImage x="42" y="0" width="6" height="6" name="weather_stale_marker">
                      <Image resource="raster_weather_stale"/>
                    </PartImage>
                  </Compare>
                </Condition>
              </Group>
            </Compare>
            <Default>
              <Group x="18" y="0" width="90" height="48" name="weather_unavailable_view">
                <PartImage x="0" y="0" width="48" height="48" name="weather_unknown_icon">
                  <Image resource="raster_weather_day_00"/>
                </PartImage>
                <PartText x="54" y="13" width="36" height="21" name="weather_unavailable_value">
                  <Text align="START">
                    <BitmapFont family="raster_fine" size="21" color="#ffffffff">--</BitmapFont>
                  </Text>
                </PartText>
              </Group>
            </Default>
          </Condition>
        </Group>

        <!-- 111..159 active-frame band: centered one-line date text. -->
        <Group x="147" y="111" width="156" height="48" name="date_region">
          <PartText x="0" y="13" width="156" height="21" name="date_value">
            <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE"/>
            <Text align="CENTER">
              <BitmapFont family="raster_fine" size="21" color="#ffffffff">
                <Template><![CDATA[%s %d %s]]>
                  <Parameter expression="[DAY_OF_WEEK] == 1 ? &quot;SUN&quot; : [DAY_OF_WEEK] == 2 ? &quot;MON&quot; : [DAY_OF_WEEK] == 3 ? &quot;TUE&quot; : [DAY_OF_WEEK] == 4 ? &quot;WED&quot; : [DAY_OF_WEEK] == 5 ? &quot;THU&quot; : [DAY_OF_WEEK] == 6 ? &quot;FRI&quot; : &quot;SAT&quot;"/>
                  <Parameter expression="[DAY]"/>
                  <Parameter expression="[MONTH_0_11] == 0 ? &quot;JAN&quot; : [MONTH_0_11] == 1 ? &quot;FEB&quot; : [MONTH_0_11] == 2 ? &quot;MAR&quot; : [MONTH_0_11] == 3 ? &quot;APR&quot; : [MONTH_0_11] == 4 ? &quot;MAY&quot; : [MONTH_0_11] == 5 ? &quot;JUN&quot; : [MONTH_0_11] == 6 ? &quot;JUL&quot; : [MONTH_0_11] == 7 ? &quot;AUG&quot; : [MONTH_0_11] == 8 ? &quot;SEP&quot; : [MONTH_0_11] == 9 ? &quot;OCT&quot; : [MONTH_0_11] == 10 ? &quot;NOV&quot; : &quot;DEC&quot;"/>
                </Template>
              </BitmapFont>
            </Text>
          </PartText>
        </Group>

        <!-- 291..339 active-frame band: footprint tile and centered step value. -->
        <Group x="153" y="291" width="162" height="48" name="steps_region">
          <PartImage x="0" y="0" width="48" height="48" name="steps_icon">
            <Image resource="raster_icon_steps"/>
          </PartImage>
          <Condition>
            <Expressions>
              <Expression name="steps_six_digits">[STEP_COUNT] &gt; 99999</Expression>
            </Expressions>
            <Compare expression="steps_six_digits">
              <PartText x="54" y="13" width="108" height="21" name="steps_six_digit_value">
                <Text align="START">
                  <BitmapFont family="raster_fine" size="21" color="#ffffffff">
                    <Template><![CDATA[%d]]>
                      <Parameter expression="clamp([STEP_COUNT], 0, 999999)"/>
                    </Template>
                  </BitmapFont>
                </Text>
              </PartText>
            </Compare>
            <Default>
              <PartText x="54" y="13" width="108" height="21" name="steps_padded_value">
                <Text align="START">
                  <BitmapFont family="raster_fine" size="21" color="#ffffffff">
                    <Template><![CDATA[%05d]]>
                      <Parameter expression="clamp([STEP_COUNT], 0, 99999)"/>
                    </Template>
                  </BitmapFont>
                </Text>
              </PartText>
            </Default>
          </Condition>
        </Group>

        <!-- 357..405 active-frame band: battery tile and centered percentage. -->
        <Group x="171" y="357" width="126" height="48" name="battery_region">
          <PartImage x="0" y="0" width="48" height="48" name="battery_icon">
            <Image resource="raster_icon_battery"/>
          </PartImage>
          <PartText x="54" y="13" width="72" height="21" name="battery_value">
            <Text align="START">
              <BitmapFont family="raster_fine" size="21" color="#ffffffff">
                <Template><![CDATA[%d%%]]>
                  <Parameter expression="clamp([BATTERY_PERCENT], 0, 100)"/>
                </Template>
              </BitmapFont>
            </Text>
          </PartText>
        </Group>
      </Group>

      <!-- One live clock, no seconds; this is also the complete ambient face. -->
      <DigitalClock x="54" y="177" width="342" height="96">
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE"/>
        <TimeText x="0" y="0" width="342" height="96" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
          <BitmapFont family="raster_time" size="96" color="#ffffffff"/>
        </TimeText>
      </DigitalClock>
    </Group>
  </Scene>
</WatchFace>
